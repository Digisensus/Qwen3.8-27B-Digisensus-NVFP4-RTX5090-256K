+    def _init_reasoning_gate(self, tokenizer, request: EngineCoreRequest) -> None:
+        if not (_GATE_STOP_ON_REASONING and self.stop):
+            return
+        start_id, end_id = _think_token_ids(tokenizer)
+        if end_id is None:
+            return
+        self._think_start_id, self._think_end_id = start_id, end_id
+        # The chat template decides whether generation begins inside the reasoning
+        # block: the prompt ends with '<think>\n' when thinking is on and with
+        # '<think>\n\n</think>\n\n' when it is off. Whichever delimiter comes last wins.
+        for tid in reversed(request.prompt_token_ids or ()):
+            if tid == end_id:
+                break
+            if tid == start_id:
+                self._in_reasoning = True
+                break
