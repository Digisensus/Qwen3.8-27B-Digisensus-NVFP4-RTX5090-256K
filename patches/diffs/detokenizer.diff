 INVALID_PREFIX_ERR_MSG = "Invalid prefix encountered"
 
+# LOCAL PATCH (vllm#52393): stop strings must not fire inside the reasoning block.
+# Upstream matches `stop` against the whole generated stream, so a stop string such as
+# '"' that the model happens to write while thinking ends the request mid-thought.
+# With this patch stop strings are only evaluated on text after the end-of-reasoning
+# token. Set VLLM_STOP_STRINGS_IN_REASONING=1 to restore upstream behaviour.
+_GATE_STOP_ON_REASONING = os.environ.get("VLLM_STOP_STRINGS_IN_REASONING", "0") != "1"
+_THINK_START, _THINK_END = "<think>", "</think>"
+_think_ids_cache: dict[int, tuple[int | None, int | None]] = {}
+
+
+def _think_token_ids(tokenizer) -> tuple[int | None, int | None]:
+    """(start_id, end_id) of the reasoning delimiters, or (None, None) if the
+    tokenizer does not have them as single tokens."""
+    key = id(tokenizer)
+    ids = _think_ids_cache.get(key)
+    if ids is None:
+        try:
+            added = tokenizer.get_added_vocab()
+            ids = (added.get(_THINK_START), added.get(_THINK_END))
+        except Exception:
+            ids = (None, None)
+        _think_ids_cache[key] = ids
+    return ids
+
 
