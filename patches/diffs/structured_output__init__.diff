+def strip_speculative_padding(token_ids: Sequence[int]) -> list[int]:
+    """Drop rejected-draft -1 padding (always trailing)."""
+    token_ids = list(token_ids)
+    if -1 in token_ids:
+        token_ids = token_ids[: token_ids.index(-1)]
+    return token_ids
