+# LOCAL PATCH (2026-09-21): the model sometimes closes a Lithuanian „quotation with an
+# unescaped ASCII '"' inside a JSON string. That '"' ENDS the string, the grammar happily
+# continues with the next key, and the rest of the field is silently lost (HTTP 200,
+# schema-valid). Measured on real scoring requests: 44% of quotations, 7/24 responses; a
+# prompt instruction only brought it to 17-31%. Fix: every free-text string gets a pattern
+# under which an opened „ must be closed by “ or ” before any '"' or the end of the value,
+# so the grammar itself refuses the truncating quote. Strings that already carry
+# pattern / enum / const / format are left alone. Disable: VLLM_JSON_BALANCED_QUOTES=0.
+_BALANCED_QUOTES = os.environ.get("VLLM_JSON_BALANCED_QUOTES", "1") != "0"
+_QUOTE_PATTERN = "^(?:[^\u201e]|\u201e[^\u201e\u201c\u201d\"]*[\u201c\u201d])*$"
+
+
+def _require_closed_quotations(spec: str | dict[str, Any]) -> str | dict[str, Any]:
+    was_str = isinstance(spec, str)
+    schema = json.loads(spec) if was_str else json.loads(json.dumps(spec))
+
+    def is_string(node: dict) -> bool:
+        t = node.get("type")
+        return t == "string" or (isinstance(t, list) and "string" in t)
+
+    def walk(node: Any) -> None:
+        if isinstance(node, dict):
+            if is_string(node) and not any(k in node for k in ("pattern", "enum", "const", "format")):
+                node["pattern"] = _QUOTE_PATTERN
+            for v in node.values():
+                walk(v)
+        elif isinstance(node, list):
+            for v in node:
+                walk(v)
+
+    walk(schema)
+    return json.dumps(schema) if was_str else schema
+
